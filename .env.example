# Token d'API Cloudflare (requis)
# Obtenez-le depuis: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_TOKEN=votre_token_ici

# Nom de la zone DNS Cloudflare (par défaut: stranix.net)
CLOUDFLARE_ZONE=stranix.net

# Nom complet du record DNS à mettre à jour (par défaut: home.stranix.net)
CLOUDFLARE_RECORD=home.stranix.net

# Intervalle de vérification en secondes (par défaut: 300 = 5 minutes)
CHECK_INTERVAL=300
